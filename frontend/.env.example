# --- Local development ---
# The browser calls relative /api/* and Next.js rewrites them to BACKEND_URL
# (see next.config.ts). Same-origin, so no CORS is involved. Leave
# NEXT_PUBLIC_API_URL unset locally.
BACKEND_URL=http://localhost:8000

# --- Production (e.g. Vercel) ---
# Set NEXT_PUBLIC_API_URL to the PUBLIC backend origin (no trailing slash).
# The browser then calls the backend directly with credentials; the backend
# must list this frontend origin in CORS_ORIGINS and issues a
# `Secure; SameSite=None` session cookie. Vercel inlines NEXT_PUBLIC_* at build
# time, so redeploy after changing it. Do NOT put secrets in NEXT_PUBLIC_*.
# NEXT_PUBLIC_API_URL=https://your-service.onrender.com
