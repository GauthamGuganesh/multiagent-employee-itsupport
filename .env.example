# Copy to .env (repo root) — backend loads it via pydantic-settings.

# --- LLM ---
# Provider: "openai" = real reasoning (needs OPENAI_API_KEY),
#           "scripted"  = offline demo mode (deterministic keyword-routed decisions;
#                         all orchestration/guards/persistence stay real),
#           "fake"      = test hook (queue-driven)
IT_LLM_PROVIDER=openai
OPENAI_API_KEY=
IT_LLM_MODEL=gpt-4o-mini

# --- Databases ---
# PostgreSQL runs locally through docker-compose. Neo4j is a hosted instance
# (for example Neo4j Aura); obtain its connection details from the web portal.
DATABASE_URL=postgresql+asyncpg://itsupport:itsupport@localhost:5433/itsupport
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<password-from-portal>
IT_NEO4J_DATABASE=neo4j

# --- Cross-session memory ---
# "local" = built-in JSON-file memory, "mem0" = hosted Mem0 Platform, "off"
IT_MEMORY_BACKEND=local
MEM0_API_KEY=

# --- ElevenLabs voice (optional; UI degrades gracefully when unset) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional shared secret for the temporary OpenAI-compatible echo endpoint.
IT_ELEVENLABS_CUSTOM_LLM_KEY=

# --- Execution limits (defaults shown; override only if needed) ---
# IT_MAX_SUPERVISOR_CYCLES=8
# IT_MAX_SPECIALIST_TOOL_STEPS=5
# IT_MAX_AGENT_HANDOFFS=4
# IT_MAX_STRUCTURED_OUTPUT_RETRIES=2
# IT_PENDING_ESCALATION_DAYS=3

# --- Deployment / CORS ---
# development | production. CORS_ORIGINS accepts JSON or comma-separated origins.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Demo auth ---
IT_SESSION_SECRET=dev-only-change-me
IT_DEMO_PASSWORD_PREFIX=gavoiceai-
IT_ADMIN_USERNAME=admin
IT_ADMIN_PASSWORD=ga-voiceai-admin
